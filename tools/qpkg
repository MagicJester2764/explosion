#!/bin/sh
# qpkg — build and inspect ExplOSion packages.
#
# A package is a gzipped tar holding PKGINFO and a files/ tree rooted at the
# target's filesystem root. Nothing exotic: the point is that installing a
# program is a defined operation with metadata attached, not a cp in a Makefile.
#
#   qpkg build <name> <version> <file>...   -> <name>-<version>.qpkg
#   qpkg info  <pkg>                        show metadata and what it will be granted
#   qpkg install <pkg> <root>               unpack into a root directory
#
# `info` reads the capability manifest out of each binary, so what a package
# will be allowed to do is inspectable before it is installed rather than
# discovered when it runs.
set -e

usage() { sed -n '2,14p' "$0" | sed 's/^# \?//'; exit 1; }

cmd_build() {
    name=$1; version=$2; shift 2
    [ -n "$name" ] && [ -n "$version" ] && [ $# -gt 0 ] || usage
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    mkdir -p "$tmp/files"
    for f in "$@"; do
        # Paths are given relative to the target root, e.g. usr/bin/CAT.ELF
        mkdir -p "$tmp/files/$(dirname "$f")"
        cp "$f" "$tmp/files/$f"
    done
    cat > "$tmp/PKGINFO" <<EOF
name = $name
version = $version
files = $#
built = $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    out="$name-$version.qpkg"
    tar -czf "$out" -C "$tmp" PKGINFO files
    echo "$out"
}

cmd_info() {
    pkg=$1; [ -f "$pkg" ] || usage
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    tar -xzf "$pkg" -C "$tmp"
    cat "$tmp/PKGINFO"
    echo "contents:"
    (cd "$tmp/files" && find . -type f | sed 's|^\./|  /|')
    echo "capabilities requested:"
    found=0
    for f in $(cd "$tmp/files" && find . -type f); do
        if python3 "$(dirname "$0")/readmanifest.py" "$tmp/files/$f" "$f"; then found=1; fi
    done
    [ "$found" = 0 ] && echo "  (none — needs no privilege)"
    true
}

cmd_install() {
    pkg=$1; root=$2
    [ -f "$pkg" ] && [ -n "$root" ] || usage
    mkdir -p "$root"
    tar -xzf "$pkg" -C "$root" --strip-components=1 files
    echo "installed $(basename "$pkg") into $root"
}

case "$1" in
    build)   shift; cmd_build "$@" ;;
    info)    shift; cmd_info "$@" ;;
    install) shift; cmd_install "$@" ;;
    *)       usage ;;
esac
