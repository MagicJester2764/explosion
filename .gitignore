# Staged artifacts from ../quark and ../bang, regenerated by `make stage`.
stage/

# Assembled images, and what an image's build writes into its EFI system
# partition on the way.
*.img
*.bin
*.iso
iso/
root.cfg

# The toytoolkit's objects and archive: intermediate, rebuilt by
# toolchain/build-weston-toytoolkit.sh. The programs made from it are tracked,
# the way the other clients are, so an image can be assembled without a cross
# toolchain.
clients/toytoolkit/

# What Python leaves beside the tools it imports.
__pycache__/

# The programs here are built in place.
programs/*/target/
